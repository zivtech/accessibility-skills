{"id":"HEADING-PA-ff8c25b563","type":"heading","sc":"2.4.6","name":"Ironwood Summit","detail":"h1","href":null,"context":"A strenuous six-mile out-and-back climbing eleven hundred feet to the highest point in the park network.","landmark":"main","visible":true,"views":1,"flags":[]}
