{"id":"HEADING-PA-3208f26d78","type":"heading","sc":"2.4.6","name":"Get outside at Alderbrook","detail":"h1","href":null,"context":"Alderbrook Parks & Trails maintains eighteen miles of hiking trails across six trailheads, from easy loop walks to a full-day ridge crossing.","landmark":"main","visible":true,"views":1,"flags":[]}
{"id":"HEADING-PA-8d77cc07ae","type":"heading","sc":"2.4.6","name":"Plan a hike","detail":"h2","href":null,"context":"Browse the trail directory for distance, difficulty, and current conditions, or open the interactive map to see everything at once.","landmark":"main","visible":true,"views":1,"flags":[]}
{"id":"HEADING-PA-7ed683ff7f","type":"heading","sc":"2.4.6","name":"Before you go","detail":"h2","href":null,"context":"Cell coverage is spotty past the second overlook. Download a trail map in advance and tell someone your planned route.","landmark":"main","visible":true,"views":1,"flags":[]}
